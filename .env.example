# Firebase web config for "Sign in with Google" sync (see AUTH_SETUP.md).
# Copy to .env (or .env.local) and fill in from Firebase console >
# Project settings > General > Your apps > Web app > SDK setup and configuration.
# Leave any of these empty and the build ships without sign-in (localStorage only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
